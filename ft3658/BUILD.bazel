load("//build/kernel/kleaf:kernel.bzl", "kernel_module")

kernel_module(
    name = "ft3658",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "include/firmware/fw_sample.i",
        "Kbuild",
    ]) + [
        "//private/google-modules/whi-staging/display:headers",
        "//private/google-modules/whi-staging/display/include:headers",
        "//private/google-modules/whi-staging/soc/gs:gs_soc_headers",
        "//private/google-modules/whi-staging/touch/common:headers",
    ],
    outs = [
        "focal_touch.ko",
    ],
    kernel_build = "//private/google-modules/whi-staging/soc/gs:gs_kernel_build",
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/whi-staging/soc/gs:__pkg__",
    ],
    deps = [
        "//private/google-modules/whi-staging/soc/gs:gs_soc_module",
        "//private/google-modules/whi-staging/touch/common:touch.common",
    ],
)
